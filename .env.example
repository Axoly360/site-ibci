# Copie as variáveis abaixo para as Environment Variables do projeto na Vercel.
# Veja o passo a passo em db/schema.sql e no plano de implementação.

# Criada automaticamente ao conectar um banco Neon/Vercel Postgres ao projeto.
DATABASE_URL=

# resend.com → API Keys
RESEND_API_KEY=

# Só é necessário depois de verificar um domínio próprio no Resend.
# Enquanto isso, o padrão "IBCI <onboarding@resend.dev>" só envia para a
# própria caixa da conta Resend (modo de teste).
RESEND_FROM_EMAIL=

# String aleatória longa (ex.: gerada com `openssl rand -hex 32`), usada
# para assinar o cookie de sessão.
AUTH_SECRET=

# IMPORTANTE — string aleatória longa e própria (ex.: `openssl rand -hex 32`),
# usada só para assinar (HMAC) os cookies de sessão do painel admin e da área
# de responsável de congregação. NUNCA reaproveite o valor de ADMIN_PASSWORD
# aqui: se essas duas variáveis forem iguais, vazar o ADMIN_PASSWORD (que é
# usado com mais frequência, inclusive no primeiro login de cada admin novo)
# também permite forjar um cookie de sessão de "Administrador geral" do zero,
# sem precisar de nenhuma senha real. Sem esta variável configurada, o
# sistema usa ADMIN_PASSWORD como fallback (e avisa isso nos logs) só para
# não quebrar ambientes antigos — configure esta variável antes do lançamento.
ADMIN_SESSION_SECRET=

# Opcional — domínio de produção do site (sem barra no final), usado no
# sitemap.xml, robots.txt e nas tags de Open Graph (prévia ao compartilhar
# o link no WhatsApp/redes sociais). Ex.: https://ibciibura.com.br
# Sem esta variável, usa a URL padrão da Vercel (site-ibci.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Criada automaticamente ao conectar o Blob Store PÚBLICO (uploads que
# qualquer visitante pode abrir: banners, eventos, escala, documentos
# institucionais) ao projeto na Vercel. Não precisa ser copiada manualmente
# se o store já estiver conectado — a Vercel injeta essa variável sozinha.
BLOB_READ_WRITE_TOKEN=

# Token do Blob Store PRIVADO — usado só para arquivos sensíveis de membros
# (comprovantes de PIX, fotos de perfil, documentos de cadastro, lançamentos
# financeiros). Esses arquivos só podem ser abertos por quem tem sessão e
# permissão, nunca por link direto.
#
# Como configurar na Vercel:
#   1. Crie um SEGUNDO Blob Store (Storage → Create Database → Blob),
#      diferente do store público já existente.
#   2. Ao conectar esse store ao projeto, escolha um PREFIXO DE VARIÁVEL
#      próprio (ex.: "BLOB_PRIVATE") em vez de aceitar o padrão — senão a
#      Vercel tenta gravar em BLOB_READ_WRITE_TOKEN de novo e sobrescreve o
#      token do store público.
#   3. Copie o valor gerado (ex.: BLOB_PRIVATE_READ_WRITE_TOKEN) para cá.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Usada só como senha de "bootstrap": o primeiro e-mail que logar em
# /admin/entrar usando esse valor como senha vira o Administrador geral
# automaticamente. Depois disso, cada administrador tem sua própria senha
# (cadastradas em /admin/administradores). Troque esse valor (ou desative o
# acesso por ele) depois do primeiro login, já que ele fica permanentemente
# válido como "senha mestra" de bootstrap enquanto a variável existir.
ADMIN_PASSWORD=
