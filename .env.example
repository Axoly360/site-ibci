# Copie as variáveis abaixo para as Environment Variables do projeto na Vercel.
# Veja o passo a passo em db/schema.sql e no plano de implementação.

# Criada automaticamente ao conectar um banco Neon/Vercel Postgres ao projeto.
DATABASE_URL=

# resend.com → API Keys
RESEND_API_KEY=

# Só é necessário depois de verificar um domínio próprio no Resend.
# Enquanto isso, o padrão "IBCI <onboarding@resend.dev>" só envia para a
# própria caixa da conta Resend (modo de teste).
RESEND_FROM_EMAIL=

# String aleatória longa (ex.: gerada com `openssl rand -hex 32`), usada
# para assinar o cookie de sessão.
AUTH_SECRET=

# Usada para assinar o cookie de sessão do painel administrativo (/admin).
# Também funciona como senha de "bootstrap": o primeiro e-mail que logar em
# /admin/entrar usando esse valor como senha vira o Administrador geral
# automaticamente. Depois disso, cada administrador tem sua própria senha
# (cadastradas em /admin/administradores) e essa variável só assina a sessão.
ADMIN_PASSWORD=
